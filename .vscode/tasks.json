{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Java Card: Build",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "RemoteSigned",
                "-File", "${workspaceFolder}/scripts/build.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Java Card: Test (jCardSim)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "RemoteSigned",
                "-File", "${workspaceFolder}/scripts/test.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Java Card: Build CAP (3.0.5)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "RemoteSigned",
                "-File", "${workspaceFolder}/scripts/build-cap.ps1"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$javac"]
        }
    ]
}
